# Firebase 프로젝트 설정 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱 에서 확인)
# 이 값들은 클라이언트에 노출되어도 안전한 공개 식별자이며, 실제 접근 제어는 Firestore/Storage Security Rules가 담당한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Messaging(FCM) 웹 푸시용 VAPID Key (Firebase Console > 프로젝트 설정 > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=

# true로 설정하면 로컬 Firebase Emulator Suite(Auth/Firestore)에 연결한다.
# 실제 프로젝트 없이 테스트하려면 PROJECT_ID를 demo-로 시작하는 값(예: demo-refill)으로 설정하고
# 다른 값들은 임의의 문자열이어도 된다. 실행: firebase emulators:start --only auth,firestore
VITE_USE_FIREBASE_EMULATOR=

# 구매 내역 변경 시 소진 주기(cycleDays)를 LLM으로 재계산하는 Vercel 서버리스 엔드포인트.
# 값이 없으면(로컬 등) 재계산을 건너뛰고 기존 cycleDays를 그대로 사용한다.
VITE_RECALCULATE_CYCLE_ENDPOINT=

# (선택) 카카오 발송 엔드포인트. 비워두면 같은 도메인의 /api/kakao-send 를 호출한다.
# vite dev 로만 띄우면 서버리스 함수가 없으므로, 로컬에서 발송을 시험하려면
# 배포된 주소(예: https://re-fill-sand.vercel.app/api/kakao-send)를 넣는다.
VITE_KAKAO_SEND_ENDPOINT=

# ---------------------------------------------------------------------------
# 아래 값은 절대 프론트엔드(.env)에 두지 않는다. VITE_ 접두사를 붙이는 순간
# Vite가 번들에 그대로 박아 넣어 누구나 볼 수 있게 된다.
# 서버리스 함수(api/*.ts)가 읽는 값이므로 Vercel 프로젝트 환경 변수에 등록한다.
#
#   OPENAI_API_KEY          analyze, recalculate-cycle
#   FIREBASE_PROJECT_ID     ID 토큰 검증 (세 엔드포인트 공용)
#   FIREBASE_CLIENT_EMAIL   서비스 계정 이메일 — kakao_tokens 접근용
#   FIREBASE_PRIVATE_KEY    서비스 계정 비공개 키 (개행을 \n 문자열로 넣을 것)
#   KAKAO_REST_API_KEY      카카오 개발자 콘솔 > 앱 키 > REST API 키
#   KAKAO_CLIENT_SECRET     (선택) 콘솔에서 Client Secret 을 켠 경우에만
#   KAKAO_LINK_URL          (선택) 메시지 버튼이 여는 주소. 기본값은 운영 배포 주소
