# Cloud Functions 전용 환경 변수 (프론트엔드에는 절대 노출하지 않는다)
# 로컬 에뮬레이터 실행 시 functions/.env.local 로 복사하여 사용한다.
# 배포 시에는 Firebase Secret Manager를 사용한다: firebase functions:secrets:set OPENAI_API_KEY
OPENAI_API_KEY=

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# scripts/kakao/*.mjs 테스트 스크립트도 이 파일(functions/.env.local)에서 같은 키를 읽는다.
KAKAO_REST_API_KEY=

# 카카오 로그인 > 보안 > Client Secret 을 '사용'으로 켠 경우에만 필요
KAKAO_CLIENT_SECRET=

# (선택) 기본값은 http://localhost:3000/oauth/kakao — 카카오 콘솔에 등록한 값과 반드시 일치해야 한다.
KAKAO_REDIRECT_URI=

# (선택) 카카오톡 메시지 버튼이 여는 주소. 기본값 http://localhost:5173
KAKAO_LINK_URL=
