# Firebase Blaze 업그레이드 전까지 카메라 분석 기능을 로컬에서 서빙하기 위한 임시 백엔드 설정
# 이 서버는 배포하지 않는다. Firebase Functions(functions/)로 이전하기 전까지만 사용한다.

# OpenAI API Key (프론트엔드에는 절대 노출하지 않는다)
OPENAI_API_KEY=

# Firebase ID Token 검증에 사용할 프로젝트 ID (.env.local의 VITE_FIREBASE_PROJECT_ID와 동일해야 한다)
FIREBASE_PROJECT_ID=

# 프론트엔드 개발 서버 origin (CORS 허용)
ALLOWED_ORIGIN=http://localhost:5173

# 서버 포트
PORT=8787
